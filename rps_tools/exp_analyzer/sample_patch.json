{
  "experiment_name": "MAT-A_sell_ub_0_to_0.1",
  "description": "Raise MAT-A.sell.ub from 0 to 0.1 and explain why OBJ changes.",

  "modifications": [
    {
      "target": "material:MAT-A",
      "field":  "sell.ub",
      "from":   0.0,
      "to":     0.1
    }
  ],

  "analysis": {
    "entry_point": {
      "type":      "material",
      "code":      "MAT-A",
      "direction": "both"
    },
    "reports": [
      "R1","R2","R3","R4","R5","R7","R8","R9","R11","R12","R13"
    ],
    "bfs_max_depth":   12,
    "min_flow_threshold": 1e-6,
    "critical_path_threshold_pct": 1.0
  },

  "files": {
    "base_input":      "base_input.json",
    "base_output":     "base_output.json",
    "modified_input":  "modified_input.json",
    "modified_output": "modified_output.json"
  }
}
